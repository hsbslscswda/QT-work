# GPU model service: complete official weights must already exist here.
MODEL_DIR=./models/Qwen2.5-14B-Instruct
MODEL_NAME=Qwen2.5-14B-Instruct
GPU_COUNT=2
MODEL_MAX_LEN=8192
MODEL_PORT=8000
MODEL_API_KEY=change-this-local-key

# Optional batch client. Use http://model:8000/v1 for the Compose GPU service.
EVALUATION_BASE_URL=http://model:8000/v1
EVALUATION_API_MODEL=Qwen2.5-14B-Instruct
EVALUATION_API_KEY=change-this-local-key
EVALUATION_HARDWARE_LABEL=fill-in-for-your-machine
